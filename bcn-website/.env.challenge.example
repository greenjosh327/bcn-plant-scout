# Keep all launch gates disabled until rules, legal compliance, privacy and staging review.
SCOUT_CHALLENGE_PAGE_VISIBLE=true
SCOUT_CHALLENGE_ENTRIES_ENABLED=false
SCOUT_CHALLENGE_DRAWINGS_ENABLED=false
SCOUT_CHALLENGE_ORIGIN=https://YOUR-WEBSITE-HOST
SCOUT_CHALLENGE_IDENTITY_SECRET=
SCOUT_CHALLENGE_TURNSTILE_SECRET=
NEXT_PUBLIC_SCOUT_CHALLENGE_TURNSTILE_SITE_KEY=
SCOUT_CHALLENGE_SPONSOR_NAME=
SCOUT_CHALLENGE_SPONSOR_ADDRESS=
SCOUT_CHALLENGE_PRIZE_ARV=
SCOUT_CHALLENGE_RULES_URL=
SCOUT_CHALLENGE_RETENTION_DAYS=
SCOUT_CHALLENGE_SEED_IDS=
# Existing NEXT_PUBLIC_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY stay server-side.
# This shared database must contain existing auth.users, bcn_admins and products.
# Never copy this service key into the Expo environment.

# Public TEST form is isolated from official entries and never uses Auth/email.
SCOUT_PREVIEW_ENABLED=false
SCOUT_PREVIEW_SECRET=
CRON_SECRET=
# Preview database gate, reviewed notice and verified cleanup must also be ready.
# Retention is fixed at 7 days; daily Vercel cleanup removes expired test data.
